# Reverse proxy for the single-server deployment (deploy/compose.yaml).
#
# A template: at startup the Nginx image substitutes ${PUBLIC_HOSTNAME},
# ${ADMIN_HOSTNAME} and ${PUBLIC_HTTPS_PORT} (from deploy/.env, passed by compose; only
# those names, see NGINX_ENVSUBST_FILTER) and writes /tmp/nginx.conf, which Nginx runs.
# Nginx's own variables ($host, $remote_addr, ...) are left alone. Shared pieces are in
# /etc/nginx/snippets/ (deploy/nginx/snippets/), not templated.
#
# Listeners inside the container (the unprivileged image cannot bind below 1024):
#   8080  plain HTTP: redirects to https://PUBLIC_HOSTNAME; Docker's health check
#   8443  HTTPS, PUBLIC_HOSTNAME: the customer page, and an allow-list of customer API
#         routes (/api/v1/...); /healthz for uptime monitors
#   9443  HTTPS, ADMIN_HOSTNAME: the staff dashboard (published on 127.0.0.1 only by
#         default; HTTP basic authentication in front of the dashboard's staff token)
#
# Upstreams (Docker service names on the internal networks):
#   customer:8501  Streamlit customer page      admin:8502  Streamlit staff dashboard
#   backend-api:8000  FastAPI, by an alias that exists on the customer network only
#
# Trusted proxy: this container has fixed addresses on the internal networks
# (deploy/compose.yaml). The backend trusts X-Forwarded-For / X-Forwarded-Proto only
# from 172.30.1.10 (FORWARDED_ALLOW_IPS), so the client address it sees for API calls is
# the one set here, from the TCP connection, never a client-supplied header. The API is
# reached as "backend-api", not "backend": this container is on both internal networks,
# and Docker's DNS answers "backend" with the admin-network address, so connections
# would come from 172.30.2.10, which is (rightly) not trusted.
# Details: docs/deployment-architecture.md, "Reverse proxy".

worker_processes auto;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    # Writable paths on the tmpfs (the root filesystem is read-only).
    client_body_temp_path /tmp/client_temp;
    proxy_temp_path       /tmp/proxy_temp;
    fastcgi_temp_path     /tmp/fastcgi_temp;
    uwsgi_temp_path       /tmp/uwsgi_temp;
    scgi_temp_path        /tmp/scgi_temp;

    # No version in the Server header or error pages; upstream Server and X-Powered-By
    # headers are never passed on (Nginx drops Server by default).
    server_tokens off;
    proxy_hide_header X-Powered-By;

    # Path only, never the query string or the referrer (they can carry customer data),
    # matching the application's own request logging.
    log_format main '$remote_addr [$time_local] "$request_method $uri $server_protocol" '
                    '$status $body_bytes_sent $request_time $server_port "$http_user_agent"';
    access_log /dev/stdout main;

    sendfile on;
    # Client side: slow or idle clients are dropped instead of holding connections.
    keepalive_timeout 30s;
    client_header_timeout 15s;
    client_body_timeout 15s;
    send_timeout 30s;
    large_client_header_buffers 4 8k;
    # Request bodies: the pages exchange small messages and accept no uploads. The API
    # routes set their own limit below.
    client_max_body_size 256k;

    # Docker's embedded DNS: re-resolve service names when a container is recreated.
    resolver 127.0.0.11 valid=10s ipv6=off;

    upstream customer_ui {
        zone customer_ui 64k;
        server customer:8501 resolve;
    }
    upstream admin_ui {
        zone admin_ui 64k;
        server admin:8502 resolve;
    }
    upstream backend_api {
        zone backend_api 64k;
        server backend-api:8000 resolve;
    }

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    # Per-client limits at the edge, keyed on the TCP peer address. Behind the pages the
    # backend sees every customer as the page container, so per-visitor limiting of the
    # page traffic happens here (docs/deployment-architecture.md, "Rate limiting").
    limit_req_zone  $binary_remote_addr zone=page_requests:10m rate=10r/s;
    # Each new Streamlit session (WebSocket) starts one conversation in the backend.
    limit_req_zone  $binary_remote_addr zone=new_sessions:10m  rate=20r/m;
    # Direct API calls (the backend applies its own per-IP limits as well).
    limit_req_zone  $binary_remote_addr zone=api_requests:10m  rate=5r/s;
    limit_conn_zone $binary_remote_addr zone=connections:10m;
    limit_req_zone  $binary_remote_addr zone=admin_requests:10m rate=5r/s;
    limit_req_status  429;
    limit_conn_status 429;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Upstream side, for every proxied request (locations may lengthen the read timeout).
    proxy_http_version 1.1;
    include /etc/nginx/snippets/proxy-headers.conf;
    proxy_connect_timeout 5s;
    proxy_read_timeout 75s;
    proxy_send_timeout 75s;
    # A failed upstream is not retried on another attempt: requests are not idempotent
    # in general (the API's own idempotency keys handle client retries).
    proxy_next_upstream off;

    # --- 8080: HTTP -> HTTPS, and Docker's health check -----------------------------
    # Requests for any other hostname (scanners, requests by IP address, forged Host
    # headers) are closed without a response (444).
    server {
        listen 8080 default_server;
        server_name _;

        location = /nginx-health {
            access_log off;
            allow 127.0.0.1;
            deny all;
            return 200 "ok\n";
        }
        # Certificate validation (Let's Encrypt HTTP-01) for the dashboard's hostname,
        # which has no server of its own on port 80. Tokens are random, public by design
        # and short-lived (docs/https-setup.md).
        include /etc/nginx/snippets/acme-challenge.conf;
        location / {
            return 444;
        }
    }
    server {
        listen 8080;
        server_name ${PUBLIC_HOSTNAME};
        # Certificate validation must answer over plain HTTP, before the redirect.
        include /etc/nginx/snippets/acme-challenge.conf;
        location / {
            # The configured name, never the client's Host header.
            return 308 https://${PUBLIC_HOSTNAME}:${PUBLIC_HTTPS_PORT}$request_uri;
        }
    }

    # --- Catch-all for the HTTPS listeners ------------------------------------------
    # A TLS connection for any other name (or without SNI, e.g. by IP address) is refused
    # during the handshake; a request whose Host does not match is closed (444).
    server {
        listen 8443 ssl default_server;
        listen 9443 ssl default_server;
        server_name _;
        ssl_reject_handshake on;
        return 444;
    }

    # --- 8443: customer page and customer API (public) ------------------------------
    server {
        listen 8443 ssl;
        http2 on;
        server_name ${PUBLIC_HOSTNAME};

        # Responses Nginx writes itself on this site are JSON (the API's error shape);
        # proxied responses keep their own type.
        default_type application/json;
        include /etc/nginx/snippets/security-headers.conf;
        include /etc/nginx/snippets/api-errors.conf;
        include /etc/nginx/snippets/ui-errors.conf;
        include /etc/nginx/snippets/secure-cookies.conf;
        limit_conn connections 20;

        # Staff credentials are never used on the public site: staff work through the
        # dashboard listener. A staff token here is refused before any routing.
        if ($http_authorization ~* "^\s*bearer\s+stf_") {
            return 403 '{"error":{"code":"STAFF_FORBIDDEN","message":"Staff credentials are not accepted here.","request_id":null}}\n';
        }

        # Readiness for uptime monitors: 200 ready, 503 not ready, and nothing more. The
        # backend's public status (/api/v1/status), never /api/v1/ready, whose checks
        # describe the deployment (whether an LLM is configured or paused, the model's
        # state). Detailed readiness stays on the private networks (Docker, the pages).
        location = /healthz {
            if ($request_method !~ ^(GET|HEAD)$) { return 404; }
            error_page 404 = @api_not_found;
            limit_req zone=page_requests burst=10 nodelay;
            # The backend sets its own security headers; keep only this server's set.
            proxy_hide_header X-Content-Type-Options;
            proxy_hide_header X-Frame-Options;
            proxy_hide_header Referrer-Policy;
            proxy_hide_header Content-Security-Policy;
            error_page 502 504 = @api_unavailable;
            proxy_pass http://backend_api/api/v1/status;
        }

        # --- Customer API: an allow-list. Anything else under /api/ is 404. ---------
        # Regular expressions are quoted: unquoted, Nginx would end them at the first
        # "{" of a repetition such as {36}.
        # Not exposed: staff routes (/api/v1/admin/*, ticket lists, status, assignment,
        # notes, events), the token-free search and answer endpoints (/answer can drive
        # paid LLM calls, SEC-07), GET / (version) and the API docs.
        location /api/ {
            # A chat message is at most 4,000 characters (32 KB request limit in the
            # backend); bigger bodies are refused here, unread.
            client_max_body_size 64k;
            limit_req zone=api_requests burst=20 nodelay;
            proxy_read_timeout 30s;
            proxy_hide_header X-Content-Type-Options;
            proxy_hide_header X-Frame-Options;
            proxy_hide_header Referrer-Policy;
            proxy_hide_header Content-Security-Policy;
            error_page 404 = @api_not_found;
            error_page 413 = @api_too_large;
            error_page 429 = @api_rate_limited;
            error_page 502 504 = @api_unavailable;

            location = /api/v1/health {
                if ($request_method !~ ^(GET|HEAD)$) { return 404; }
                proxy_pass http://backend_api;
            }
            # Public status only; /api/v1/ready (detailed) is not proxied (see /healthz).
            location = /api/v1/status {
                if ($request_method !~ ^(GET|HEAD)$) { return 404; }
                proxy_pass http://backend_api;
            }
            # Start, read, close and delete a conversation; read its messages.
            location ~ "^/api/v1/conversations(/[0-9A-Fa-f-]{36}(/(messages|close))?)?$" {
                proxy_pass http://backend_api;
            }
            # One chat turn: up to two LLM calls with retries (the backend's slowest
            # turn is about 136 s with the default OpenAI settings). A client that gives
            # up earlier retries with the same client_message_id and gets the stored reply.
            location ~ "^/api/v1/conversations/[0-9A-Fa-f-]{36}/chat$" {
                proxy_read_timeout 150s;
                proxy_pass http://backend_api;
            }
            # Customers may only create tickets here; GET on this path is the staff list.
            location = /api/v1/support/tickets {
                if ($request_method != POST) { return 404; }
                proxy_pass http://backend_api;
            }
            # A customer reads their own ticket (conversation token required).
            location ~ "^/api/v1/support/tickets/[A-Za-z0-9_-]{1,64}$" {
                if ($request_method !~ ^(GET|HEAD)$) { return 404; }
                proxy_pass http://backend_api;
            }
            # The public knowledge base, read-only.
            location ~ "^/api/v1/faqs(/categories|/search|/[A-Za-z0-9_-]{1,64})?$" {
                if ($request_method !~ ^(GET|HEAD)$) { return 404; }
                proxy_pass http://backend_api;
            }

            return 404;
        }

        # Streamlit's WebSocket: one per browser session, long-lived.
        location = /_stcore/stream {
            limit_req zone=new_sessions burst=10 nodelay;
            include /etc/nginx/snippets/websocket.conf;
            error_page 502 504 = @ui_unavailable;
            proxy_pass http://customer_ui;
        }

        # The customer page takes no file uploads.
        location ^~ /_stcore/upload_file {
            return 404;
        }

        location / {
            limit_req zone=page_requests burst=40 nodelay;
            error_page 502 504 = @ui_unavailable;
            proxy_pass http://customer_ui;
        }
    }

    # --- 9443: staff dashboard (restricted) -----------------------------------------
    server {
        listen 9443 ssl;
        http2 on;
        # The name staff type in the browser: localhost through an SSH tunnel, or a
        # VPN-only name. Any other name is refused by the catch-all above.
        server_name ${ADMIN_HOSTNAME};

        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-store" always;
        include /etc/nginx/snippets/ui-errors.conf;
        include /etc/nginx/snippets/secure-cookies.conf;

        # A second, independent credential in front of the dashboard's staff token.
        auth_basic "Staff";
        auth_basic_user_file /etc/nginx/admin.htpasswd;

        # Private networks only: the staff identity is a development-grade prototype, so
        # the dashboard must never be reachable from the public internet, even when
        # ADMIN_BIND is widened for a VPN. Narrow the list to your VPN range if you can.
        include /etc/nginx/snippets/admin-network-allowlist.conf;

        limit_conn connections 10;

        # The staff API is not proxied: the dashboard calls it server-side, over the
        # private admin network. (Basic authentication here and the API's bearer token
        # would both need the Authorization header.)
        location /api/ {
            return 404;
        }

        location = /_stcore/stream {
            limit_req zone=admin_requests burst=10 nodelay;
            include /etc/nginx/snippets/websocket.conf;
            error_page 502 504 = @ui_unavailable;
            proxy_pass http://admin_ui;
        }

        location / {
            limit_req zone=admin_requests burst=20 nodelay;
            error_page 502 504 = @ui_unavailable;
            proxy_pass http://admin_ui;
        }
    }
}
