# Customer page settings for DEPLOY_ENV=production. Copy to customer.env (git-ignored).
# Described in the project's .env.example (frontend section). BACKEND_API_URL is fixed
# by deploy/compose.yaml (http://backend:8000 on the private customer network).

DEMO_MODE=false
# Should match the backend's MAX_CUSTOMER_MESSAGE_CHARACTERS.
MAX_MESSAGE_CHARACTERS=4000
SUPPORT_CONTACT_URL=
EXAMPLE_QUESTIONS=["How can I track my order?","What is your return policy?","How do I reset my password?"]
BACKEND_CONNECT_TIMEOUT_SECONDS=5
BACKEND_READ_TIMEOUT_SECONDS=60
BACKEND_MAX_RETRIES=2
BACKEND_MAX_RETRY_WAIT_SECONDS=5
# DEBUG | INFO | WARNING | ERROR | CRITICAL. LOG_FORMAT is fixed to json by compose.
LOG_LEVEL=INFO
