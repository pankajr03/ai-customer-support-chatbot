# Staff dashboard settings for DEPLOY_ENV=production. Copy to admin.env (git-ignored).
# BACKEND_API_URL is fixed by deploy/compose.yaml (http://backend:8000 on the private
# admin network).

ADMIN_IDLE_TIMEOUT_MINUTES=30
ADMIN_MAX_SESSION_HOURS=8
BACKEND_CONNECT_TIMEOUT_SECONDS=5
BACKEND_READ_TIMEOUT_SECONDS=60
