# Backend settings for DEPLOY_ENV=production. Copy to backend.env (git-ignored) and keep
# it readable only by the deploying user (chmod 600). Every variable is described in the
# project's .env.example; only those that differ from the defaults, or must be decided
# for a deployment, are listed here.
#
# Fixed by deploy/compose.yaml and not settable here: DATABASE_URL, FAQ_DATA_PATH,
# EMBEDDING_MODEL_NAME, HF_HUB_OFFLINE.

APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO
# Copy the in-memory metrics to the log every N seconds (0 = never). docs/monitoring.md
METRICS_LOG_INTERVAL_SECONDS=300

# The API is not exposed to browsers (the Streamlit pages call it server-side).
CORS_ORIGINS=[]

# --- Rate limits ---------------------------------------------------------------------
# Behind the customer page, every customer reaches the backend from the same address
# (the customer container), so the per-IP limits below are SITE-WIDE totals, not per
# visitor. Per-visitor limits are enforced by Nginx (deploy/nginx/nginx.conf.template). These
# values are a safety ceiling for the whole site; size them to expected traffic.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=3000
RATE_LIMIT_NEW_CONVERSATIONS_PER_MINUTE=300
# Per conversation (keyed by conversation and token), so still per customer:
RATE_LIMIT_CHAT_MESSAGES_PER_MINUTE=20
RATE_LIMIT_SUPPORT_REQUESTS_PER_MINUTE=5
# Not reachable from outside in this architecture (no public API route):
RATE_LIMIT_PUBLIC_SEARCH_PER_MINUTE=30

# --- Model and storage ---------------------------------------------------------------
# Serve at once; the model loads in the background (22-160 s) and readiness does not
# wait for it.
SEMANTIC_INDEX_PRELOAD=background
CONVERSATION_TTL_MINUTES=60
CONVERSATION_CLEANUP_ON_STARTUP=true
# "estimate" needs no download; "tiktoken" would fetch an encoding file at first use.
CONTEXT_TOKENIZER=estimate

# --- Support and staff ---------------------------------------------------------------
# Entries from: docker compose run --rm --no-deps backend python -m scripts.create_staff_token <id> --role admin
STAFF_TOKEN_HASHES=[]
SUPPORT_RESPONSE_TIME_TEXT=
SUPPORT_TICKET_RETENTION_DAYS=365

# --- LLM -----------------------------------------------------------------------------
# Off until the live evaluation, spending cap and data-processing agreement are in place
# (docs/deployment-readiness.md, External API dependency).
LLM_ENABLED=false
OPENAI_API_KEY=
