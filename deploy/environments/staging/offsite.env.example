# Off-server backup copies (restic) for DEPLOY_ENV=staging. Copy to offsite.env
# (git-ignored), chmod 600, fill in, then start the service with the "offsite" profile:
#   docker compose --profile offsite up -d
# Without this file and the profile, no off-server copy is made. See
# docs/backup-and-restore.md, "Off-server copies".

# Where the encrypted copies go: a restic repository on storage you control, OFF this
# server. Examples:
#   s3:https://s3.eu-central-1.amazonaws.com/your-bucket/support-chatbot
#   b2:your-bucket:support-chatbot
#   sftp:backup@backup-host.example.com:/srv/restic/support-chatbot
RESTIC_REPOSITORY=

# The encryption password (restic encrypts on this server with it; without it the copies
# cannot be read, so store it in a password manager as well). Long and random, e.g.
# openssl rand -base64 32. Or RESTIC_PASSWORD_FILE pointing to a mounted file.
RESTIC_PASSWORD=

# Credentials for the storage (only the ones your repository type needs). Use a key that
# may write to this one location only.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# B2_ACCOUNT_ID=
# B2_ACCOUNT_KEY=

# Daily copy time (HH:MM UTC); after the local backup (BACKUP_AT, default 03:00).
OFFSITE_AT=03:30
# Snapshots kept in the repository.
OFFSITE_KEEP_DAILY=14
OFFSITE_KEEP_WEEKLY=8
OFFSITE_KEEP_MONTHLY=6
# true: also copy right after starting (useful to test the configuration).
OFFSITE_RUN_ON_START=false
