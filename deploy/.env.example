# Docker Compose variables for deploy/compose.yaml. Copy to deploy/.env (git-ignored)
# and adjust. Compose reads this file only when run from deploy/, so the project root's
# development .env is never used here. Application settings (APP_ENV, secrets, limits)
# live in deploy/environments/<DEPLOY_ENV>/*.env, documented in the root .env.example.
# Nothing here is secret.

# --- Environment ---------------------------------------------------------------------
# Which folder under deploy/environments/ to use: production or staging (or one you add).
# Required: compose refuses to start without it.
DEPLOY_ENV=production

# Tag for the locally built images (for example a git commit).
IMAGE_TAG=local

# --- Public site (reverse proxy) -------------------------------------------------------
# The customer site's hostname, as customers type it, e.g. support.example.com. Required:
# compose refuses to start without it. Nginx answers only this name: requests by IP
# address or for any other name are refused (TLS handshake rejected, or connection
# closed), and HTTP redirects always go to https://PUBLIC_HOSTNAME. The TLS certificate in
# deploy/nginx/certs/ must be valid for it.
PUBLIC_HOSTNAME=support.example.com

# Interface and ports Nginx publishes for the public site. 0.0.0.0 = every interface.
# PUBLIC_HTTP_PORT only redirects to HTTPS. If PUBLIC_HTTPS_PORT is not 443, the
# redirect includes it.
PUBLIC_BIND=0.0.0.0
PUBLIC_HTTP_PORT=80
PUBLIC_HTTPS_PORT=443

# --- Staff dashboard (protected listener) ------------------------------------------------
# The dashboard has its own HTTPS listener with HTTP basic authentication
# (deploy/nginx/admin.htpasswd) in front of the staff token. Keep ADMIN_BIND=127.0.0.1
# and reach it through an SSH tunnel:
#   ssh -L 8443:127.0.0.1:8443 you@server      then open https://localhost:8443
# or set a VPN interface address. Never 0.0.0.0 without the allow-list in
# deploy/nginx/nginx.conf.template.
ADMIN_BIND=127.0.0.1
ADMIN_HTTPS_PORT=8443
# The hostname staff type in the browser: localhost through a tunnel (the default), or
# a VPN-only name. Any other name is refused. The certificate must cover it too.
ADMIN_HOSTNAME=localhost

# --- Model cache ---------------------------------------------------------------------------
# The embedding model fetched once by "docker compose --profile setup run --rm model-init"
# into the "models" volume, mounted read-only at /models in the backend (the path is
# fixed by compose.yaml). The default revision is the one every Stage 12 evaluation used;
# change it only together with a new evaluation run.
EMBEDDING_MODEL_REPO=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
