# Docker Compose variables for deploy/compose.yaml. Copy to deploy/.env (git-ignored).
# These choose the environment and the published ports; application settings live in
# deploy/environments/<DEPLOY_ENV>/*.env.

# Which folder under deploy/environments/ to use: production or staging (or one you add).
DEPLOY_ENV=production

# Tag for the locally built images (for example a git commit).
IMAGE_TAG=local

# Public listeners (customer page). 0.0.0.0 = every interface of the server.
# The HTTP listener only redirects to HTTPS; the redirect assumes HTTPS on port 443.
PUBLIC_BIND=0.0.0.0
PUBLIC_HTTP_PORT=80
PUBLIC_HTTPS_PORT=443

# Staff dashboard. Keep 127.0.0.1 and reach it through an SSH tunnel
# (ssh -L 8443:127.0.0.1:8443 you@server, then https://localhost:8443), or set a VPN
# interface address. Never 0.0.0.0 without the allow-list in deploy/nginx/nginx.conf.
ADMIN_BIND=127.0.0.1
ADMIN_HTTPS_PORT=8443

# The embedding model fetched by model-init. The default revision is the one every
# Stage 12 evaluation used; change it only together with a new evaluation run.
EMBEDDING_MODEL_REPO=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
