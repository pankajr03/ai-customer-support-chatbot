# -----------------------------------------------------------------------------
# Example configuration. Copy to .env and adjust:   Copy-Item .env.example .env
# .env is git-ignored. Never commit real secrets, and never put them in this file.
# Every variable is optional; the values below are the safe development defaults.
# -----------------------------------------------------------------------------

# Display name shown in the API docs and the GET / response.
APP_NAME="AI Customer Support Chatbot API"

# development | staging | production
# production disables /docs, /redoc and /openapi.json.
APP_ENV=development

# true | false. Must be false when APP_ENV=production (startup fails otherwise).
DEBUG=false

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Prefix for versioned API routes. Must start with "/" and have no trailing slash.
API_V1_PREFIX=/api/v1

# JSON list of browser origins allowed to call the API (CORS). Empty = no cross-origin
# access (the default). List exact origins: scheme, host and port, no path, no "*".
# Local development: Streamlit (8501) and a Vite/React dev server (5173):
#   CORS_ORIGINS=["http://localhost:8501","http://localhost:5173"]
# Production: https:// origins only (checked at startup), e.g. ["https://shop.example.com"].
# CORS is not authentication: every conversation request still needs its bearer token.
CORS_ORIGINS=[]

# Largest accepted request body in bytes (1024-1048576). Larger bodies get 413 unparsed.
# Must be at least 4 x MAX_CUSTOMER_MESSAGE_CHARACTERS + 1024 (checked at startup).
MAX_REQUEST_BODY_BYTES=32768

# Longest customer chat message in characters (100-10000), after surrounding whitespace
# is removed. Longer messages get 422. Only the first 1000 characters are used for
# search; the whole message is stored and shown in the history.
MAX_CUSTOMER_MESSAGE_CHARACTERS=4000

# Basic request-rate limits: a prototype safeguard, PROCESS-LOCAL and in memory (reset on
# restart, counted separately by each worker process, not shared between servers). Over a
# limit a request gets 429 RATE_LIMITED with Retry-After. Durable limits are Stage 8 work.
RATE_LIMIT_ENABLED=true
# Every API request except /health, per client IP address.
RATE_LIMIT_REQUESTS_PER_MINUTE=120
# POST /api/v1/conversations, per client IP address.
RATE_LIMIT_NEW_CONVERSATIONS_PER_MINUTE=20
# POST /api/v1/conversations/{id}/chat, per conversation (and access token).
RATE_LIMIT_CHAT_MESSAGES_PER_MINUTE=20

# FAQ knowledge base (JSON). Relative paths are resolved from the project root.
# Point this at a client-specific file to replace the sample FAQs.
# The app refuses to start if the file is missing or invalid.
FAQ_DATA_PATH=data/faqs.json

# Conversation storage (Stage 6). SQLite only: a development and small-demo choice, not
# for large or multi-server deployments. Relative paths are resolved from the project
# root; the folder is created if needed. *.db files are git-ignored.
# "sqlite://" keeps everything in memory (lost on restart; useful for tests).
DATABASE_URL=sqlite:///data/conversations.db

# Minutes after creation that a conversation stops accepting messages (1-10080, i.e. up
# to 7 days). Its history stays readable with its access token until it is deleted.
CONVERSATION_TTL_MINUTES=60

# While one message is being answered, other messages to the same conversation are
# refused with 409 and Retry-After. The lock is a lease stored in the database: it is
# released when the reply is stored, or expires after this many seconds (10-900) if the
# process died. It must outlast the slowest answer: with LLM_ENABLED=true, at least
# OPENAI_TIMEOUT_SECONDS x (OPENAI_MAX_RETRIES + 1) x 2 (checked at startup).
CONVERSATION_PROCESSING_LEASE_SECONDS=180

# true | false. Delete expired conversations and their messages when the app starts.
# Run the same cleanup any time with: python -m scripts.cleanup_conversations
CONVERSATION_CLEANUP_ON_STARTUP=true

# Context window. CHARACTER limits (*_CHARS) count characters of message text; the TOKEN
# limit (*_TOKENS) counts model tokens. Older context is omitted first, never summarised.
#
# Recent history used as context for a new message: at most this many messages (1-50)
# and this many characters of message text in total (200-50000). Only the database rows
# needed are read.
CONVERSATION_HISTORY_MAX_MESSAGES=10
CONVERSATION_HISTORY_MAX_CHARS=4000
# A single history message longer than this many characters (100-10000) is shortened to
# its beginning, so one long reply cannot push out the rest of the conversation.
CONVERSATION_HISTORY_MAX_MESSAGE_CHARS=1000
# TOKEN limit (500-200000) for an LLM request that includes history (query rewriting).
# Instructions, the new message and the reserved output are counted first; history gets
# what is left, newest first. If even those do not fit, the LLM is not called.
CONVERSATION_CONTEXT_MAX_TOKENS=3000
# How tokens are counted: estimate (UTF-8 bytes / 3, no download; usually over-counts
# English) | tiktoken (exact for OpenAI models; downloads TIKTOKEN_ENCODING once and
# falls back to the estimate if it cannot).
CONTEXT_TOKENIZER=estimate
TIKTOKEN_ENCODING=o200k_base

# true | false. Rewrite follow-up messages ("what about after that?") into standalone
# search queries with the LLM, when LLM_ENABLED=true. Rewrites are checked and rejected
# if they add words or numbers not in the conversation. Without the LLM (or when a
# rewrite is rejected) the earlier customer question is put before the follow-up.
QUERY_REWRITE_USE_LLM=true
# Most recent history messages considered when rewriting (1-20).
QUERY_REWRITE_MAX_TURNS=6

# Sentence-embedding model for semantic search: a Hugging Face model ID or a local folder.
# The model is NOT loaded when the app is imported; it loads when first needed.
# On first use it is downloaded (~90 MB for the default) and cached under
#   %USERPROFILE%\.cache\huggingface   (change with the HF_HOME environment variable).
# After the first download it works offline; set HF_HUB_OFFLINE=1 to forbid downloads.
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# true | false. Build the semantic FAQ index at startup (in a background worker thread)
# instead of on the first semantic search. Startup takes longer (model load), the first
# search does not. If preloading fails, the app still starts and retries on first use.
# Each worker process (e.g. uvicorn --workers 4) builds and holds its own index.
SEMANTIC_INDEX_PRELOAD=false

# Seconds to wait after a failed model load before trying again (0-3600). Meanwhile
# semantic search answers 503 with a Retry-After header instead of every queued
# request repeating a slow failing download.
EMBEDDING_LOAD_RETRY_SECONDS=30

# Default result filter of the POST /api/v1/semantic-search endpoint (cosine, -1 to 1).
# Results scoring below it are not returned. Callers can override it per request with
# "min_similarity"; -1 effectively disables it. EXPERIMENTAL. This does NOT affect the
# answer decision below, which has its own ANSWER_MIN_SIMILARITY.
SEMANTIC_MIN_SIMILARITY=0.40

# =============================================================================
# Decision thresholds
# Three separate responsibilities: retrieval ranking, answer acceptance and ambiguity
# detection. All values are EXPERIMENTAL starting points, not universally reliable.
# Calibrate them with a labelled evaluation dataset for your model and knowledge base
# (README, "Decision thresholds").
# =============================================================================

# --- 1. Retrieval ranking: orders candidates; never decides whether to answer --------
# Reciprocal Rank Fusion constant k (1-1000). Larger values give lower ranks more weight.
HYBRID_RRF_K=60
# Candidates taken from each retriever (keyword, semantic) before fusion (2-50).
HYBRID_CANDIDATE_DEPTH=20
# Top-ranked candidates the answer decision evaluates (2-50, <= HYBRID_CANDIDATE_DEPTH).
ANSWER_CANDIDATES=5

# --- 2. Answer acceptance: is a candidate relevant enough to show? -------------------
# Minimum semantic cosine similarity (-1 to 1) for an FAQ to be answered.
ANSWER_MIN_SIMILARITY=0.40
# true | false. Accept an exact (normalised) question match on its own.
ANSWER_ACCEPT_EXACT_QUESTION=true
# Semantic model unavailable: keyword-only answers need an exact question match, or a
# clear keyword score at least this high (1-1000; 40 = query is inside the question) ...
DEGRADED_MIN_KEYWORD_SCORE=40
# ... from a query with at least this many meaningful (non-stopword) words (1-20).
DEGRADED_MIN_QUERY_TERMS=2

# --- 3. Ambiguity detection: are acceptable candidates too close to choose? ----------
# Another acceptable FAQ within this cosine margin of the top one (or above it) leads to
# a clarifying question instead of an answer (0-1).
ANSWER_AMBIGUITY_MARGIN=0.05
# Most FAQs named in one clarifying question (2-10).
ANSWER_MAX_CLARIFICATION_OPTIONS=3

# --- Fallback messages (customer-facing text, 1-500 characters) ----------------------
FALLBACK_NO_MATCH_MESSAGE="Sorry, I couldn't find a reliable answer to that question. Please contact our support team for assistance."
FALLBACK_UNAVAILABLE_MESSAGE="Sorry, I can't search our help articles right now. Please try again in a few minutes or contact our support team for assistance."

# =============================================================================
# OpenAI (Stage 5): text generation with the Responses API
# Off by default. With LLM_ENABLED=false no key is needed and every Stage 1-4 endpoint
# works normally. With LLM_ENABLED=true the app refuses to start without a valid key.
# =============================================================================

# Switch LLM generation on (true) or off (false).
LLM_ENABLED=false
# Secret: your key from https://platform.openai.com/api-keys. Put the real value only in
# your local .env (git-ignored) or the server environment. Never commit it, never paste it
# into this file. Leave empty while LLM_ENABLED=false.
OPENAI_API_KEY=
# Text model. A small, fast model suits short replies grounded in FAQ answers.
OPENAI_MODEL=gpt-5.4-mini
# Per-attempt timeout in seconds (0-300). The SDK default (10 minutes) is far too long.
OPENAI_TIMEOUT_SECONDS=20
# Extra attempts after a transient failure (timeout, 408/409/429/5xx), 0-5.
# Invalid keys, unknown models and malformed requests are never retried.
OPENAI_MAX_RETRIES=2
# Upper bound on generated tokens per reply, including reasoning tokens (16-4096).
OPENAI_MAX_OUTPUT_TOKENS=800
# Reasoning effort for reasoning models: none, minimal, low, medium, high, xhigh or max.
# Leave empty for models that do not support reasoning settings.
OPENAI_REASONING_EFFORT=low
# Sampling temperature (0-2). Leave empty to use the model's default (recommended).
# Reasoning models reject it unless OPENAI_REASONING_EFFORT is none or empty; the app
# checks this at startup.
LLM_TEMPERATURE=
# Pause LLM calls after this many consecutive failed calls (1-20). An invalid key, missing
# permission, unknown model or exhausted quota pauses at once ...
LLM_FAILURE_THRESHOLD=3
# ... for this many seconds (0-3600; 0 = never pause). Customers get the approved FAQ
# answer meanwhile, and search is never affected.
LLM_FAILURE_COOLDOWN_SECONDS=60
# Grounded context: at most this many retrieved FAQs per prompt (1-10) ...
LLM_CONTEXT_MAX_FAQS=3
# ... within this many characters of evidence (500-50000; about 4 characters per token).
# Approved answers are never truncated: an FAQ that does not fit is left out.
LLM_CONTEXT_MAX_CHARS=6000

# --- Usage tracking: cost ESTIMATES (monitoring only, not billing) --------------------
# Token counts are always taken from the API's own usage data. A cost estimate is only
# calculated for models listed here; others report no cost. No prices are built in:
# copy the current rates you pay from your OpenAI pricing page and keep them up to date.
# JSON object: model name -> prices per 1 million tokens (cached input is optional and
# defaults to the input price). A model name also covers its dated snapshots, e.g.
# "gpt-5.4-mini" prices "gpt-5.4-mini-2026-03-17". Example shape (replace the zeros):
#   LLM_PRICING={"gpt-5.4-mini": {"input_per_million_tokens": 0.0, "output_per_million_tokens": 0.0, "cached_input_per_million_tokens": 0.0}}
LLM_PRICING={}
# Currency of those prices (ISO 4217 code).
LLM_PRICING_CURRENCY=USD
