# Copy this file to .env and adjust values. Never commit .env.

# development | staging | production  (production disables /docs and /openapi.json)
ENVIRONMENT=development

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# JSON list of browser origins allowed to call the API (empty = no cross-origin access)
# Example for a local Streamlit frontend: ["http://localhost:8501"]
CORS_ORIGINS=[]
