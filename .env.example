# =============================================================================
# Example configuration. Copy to .env and adjust:   Copy-Item .env.example .env
# .env is git-ignored. Never commit real secrets, and never put them in this file.
#
# Every variable is optional: the values below are the code's defaults, safe for local
# development (no LLM, no staff, no cross-origin access, rate limits on). Read by the
# backend (app/core/config.py) and the Streamlit pages (frontend/config.py); each
# ignores the other's variables. Real environment variables override this file.
#
# Validation: every value is checked at startup. An invalid one stops the process with
# the variable's NAME and the rule it broke, never its value (secrets are never printed,
# logged or echoed in errors; the startup log shows only a safe summary).
#
# With APP_ENV=production the backend also refuses to start when:
#   - DEBUG=true;
#   - CORS_ORIGINS contains a plain http:// origin;
#   - LLM_ENABLED=true and OPENAI_API_KEY is missing, contains spaces or looks truncated;
#   - DATABASE_URL is an in-memory database (all data would be lost on restart);
#   - RATE_LIMIT_ENABLED=false.
# API docs (/docs, /redoc, /openapi.json) are switched off in production automatically.
#
# Sections: 1 Application, 2 Security, 3 AI: language model, 4 AI: retrieval and answer
# decisions, 5 Conversations, 6 Support tickets, 7 Streamlit pages, 8 Deployment.
# =============================================================================


# =============================================================================
# 1. Application
# =============================================================================

# Display name shown in the API docs and the GET / response (1-100 characters).
APP_NAME="AI Customer Support Chatbot API"

# development | staging | production. production switches off the API docs and applies
# the checks listed at the top.
APP_ENV=development

# true | false. Keeps exception messages in tracebacks (they can quote customer text).
# Must be false when APP_ENV=production (startup fails otherwise).
DEBUG=false

# DEBUG | INFO | WARNING | ERROR | CRITICAL. Logs never contain message text, tokens or
# keys at any level (they are redacted as a safety net).
LOG_LEVEL=INFO

# text (readable lines, for development) | json (one JSON object per line: timestamp,
# level, service, request_id, route, status, duration_ms, error_category...). The Docker
# deployment uses json. LOG_LEVEL and LOG_FORMAT are also read by the Streamlit pages.
# docs/logging.md
LOG_FORMAT=text

# Service name in /health and /ready responses (lowercase letters, digits and hyphens).
SERVICE_NAME=ai-customer-support-chatbot

# Prefix for versioned API routes. Must start with "/" and have no trailing slash.
API_V1_PREFIX=/api/v1

# Conversation, ticket, FAQ and audit storage. SQLite only: one file, one writer at a
# time, one machine (see docs/deployment-architecture.md). Relative paths are resolved
# from the project root; the folder is created if needed. *.db files are git-ignored.
# "sqlite://" keeps everything in memory: lost on restart, for tests only, refused in
# production.
DATABASE_URL=sqlite:///data/conversations.db

# FAQ seed file (JSON). The FAQs live in the database (DATABASE_URL) and are edited on the
# admin dashboard. This file only fills an EMPTY FAQ table once, at startup; it never
# overwrites FAQs already in the database. To add new FAQs from it later:
# python -m scripts.import_faqs --backup. Relative paths are resolved from the project
# root. The app refuses to start if the table is empty and this file is missing or invalid.
FAQ_DATA_PATH=data/faqs.json

# Where the Streamlit pages find the backend (read by the pages only). Use https:// for
# anything but a backend on this machine or a private network (the pages log a warning
# for plain http:// to another host). In Docker Compose this is http://backend:8000 on
# the private network, set by deploy/compose.yaml.
BACKEND_API_URL=http://127.0.0.1:8000
# The backend's API_V1_PREFIX.
BACKEND_API_PREFIX=/api/v1


# =============================================================================
# 2. Security
# =============================================================================

# --- Staff authentication ------------------------------------------------------------
# JSON list of "staff_id:role:sha256-of-token" entries, role admin or support.
#   admin   - FAQ management, tickets, analytics, audit log (admin dashboard)
#   support - tickets only
# A Stage 10 entry without a role ("staff_id:sha256") counts as support.
# Create one with: python -m scripts.create_staff_token alex --role admin
# Only hashes go here, never tokens; give each person their own token. Entries are
# validated at startup without being echoed. Empty = every staff operation is refused
# (logged as a warning in production). Revoke a token by removing its entry and
# restarting. Prototype staff access: no login, token expiry or MFA (SEC-08,
# docs/security-audit.md).
STAFF_TOKEN_HASHES=[]

# --- Session expiration --------------------------------------------------------------
# Minutes after creation that a conversation stops accepting messages (1-10080, i.e. up
# to 7 days); not extended by activity. Its history stays readable with its access token
# until it is deleted.
CONVERSATION_TTL_MINUTES=60
# Staff dashboard (read by the pages only): forget the staff token after this many minutes
# without activity (1-480), or this many hours after signing in (up to 24). The token
# itself stays valid on the API, which has no expiry.
ADMIN_IDLE_TIMEOUT_MINUTES=30
ADMIN_MAX_SESSION_HOURS=8

# --- Allowed origins (CORS) ------------------------------------------------------------
# JSON list of browser origins allowed to call the API directly. Empty = no cross-origin
# access (the default, and right for the Streamlit pages and the Docker deployment, where
# the API is called server-side). List exact origins: scheme, host and port, no path,
# no "*" (rejected). Local example for a Vite/React dev server:
#   CORS_ORIGINS=["http://localhost:5173"]
# Production: https:// origins only (checked at startup). CORS is not authentication:
# every conversation request still needs its bearer token.
CORS_ORIGINS=[]

# --- Request limits --------------------------------------------------------------------
# Largest accepted request body in bytes (1024-1048576). Larger bodies get 413 unparsed.
# Must be at least 4 x MAX_CUSTOMER_MESSAGE_CHARACTERS + 1024 (checked at startup).
MAX_REQUEST_BODY_BYTES=32768
# Longest customer chat message in characters (100-10000), after surrounding whitespace
# is removed. Longer messages get 422. Only the first 1000 characters are used for
# search; the whole message is stored and shown in the history.
MAX_CUSTOMER_MESSAGE_CHARACTERS=4000
# The pages' chat input limit (read by the pages only); keep it equal to
# MAX_CUSTOMER_MESSAGE_CHARACTERS.
MAX_MESSAGE_CHARACTERS=4000

# --- Rate limits -----------------------------------------------------------------------
# Process-local and in memory: reset on restart, counted separately by each worker
# process, not shared between servers. Over a limit a request gets 429 RATE_LIMITED with
# Retry-After. Behind the Streamlit pages every customer shares the page's address, so the
# per-IP limits become site-wide (docs/deployment-architecture.md, "Rate limiting").
# true | false. false only for local load tests; refused in production.
RATE_LIMIT_ENABLED=true
# Every API request except /health and /ready, per client IP address (1-100000).
RATE_LIMIT_REQUESTS_PER_MINUTE=120
# POST /api/v1/conversations, per client IP address (1-10000).
RATE_LIMIT_NEW_CONVERSATIONS_PER_MINUTE=20
# POST /api/v1/conversations/{id}/chat, per conversation and access token (1-10000).
RATE_LIMIT_CHAT_MESSAGES_PER_MINUTE=20
# POST /api/v1/support/tickets, per conversation access token (1-1000).
RATE_LIMIT_SUPPORT_REQUESTS_PER_MINUTE=5
# POST /answer, /semantic-search and /hybrid-search together, per client IP (1-10000).
# They need no token, run the embedding model, and /answer can call the paid LLM.
RATE_LIMIT_PUBLIC_SEARCH_PER_MINUTE=30


# =============================================================================
# 3. AI: language model (OpenAI Responses API)
# Off by default. With LLM_ENABLED=false no key is needed and customers get the approved
# FAQ answers. With LLM_ENABLED=true the app refuses to start without a valid key.
# =============================================================================

# true | false. Switch LLM generation on.
LLM_ENABLED=false
# Secret: your key from https://platform.openai.com/api-keys. Put the real value only in
# your local .env (git-ignored) or the server environment / deploy env file. Never commit
# it, never paste it into this file. Leave empty while LLM_ENABLED=false. Held as a secret
# value: masked in logs and errors; the startup summary shows only whether it is set.
OPENAI_API_KEY=
# Text model. A small, fast model suits short replies grounded in FAQ answers.
OPENAI_MODEL=gpt-5.4-mini
# Per-attempt timeout in seconds (0-300). The SDK default (10 minutes) is far too long.
OPENAI_TIMEOUT_SECONDS=20
# Extra attempts after a transient failure (timeout, 408/409/429/5xx), 0-5.
# Invalid keys, unknown models and malformed requests are never retried.
OPENAI_MAX_RETRIES=2
# Upper bound on generated tokens per reply, including reasoning tokens (16-4096).
OPENAI_MAX_OUTPUT_TOKENS=800
# Reasoning effort for reasoning models: none, minimal, low, medium, high, xhigh or max.
# Leave empty for models that do not support reasoning settings.
OPENAI_REASONING_EFFORT=low
# Sampling temperature (0-2). Leave empty to use the model's default (recommended).
# Reasoning models reject it unless OPENAI_REASONING_EFFORT is none or empty; the app
# checks this at startup.
LLM_TEMPERATURE=
# Pause LLM calls after this many consecutive failed calls (1-20). An invalid key, missing
# permission, unknown model or exhausted quota pauses at once ...
LLM_FAILURE_THRESHOLD=3
# ... for this many seconds (0-3600; 0 = never pause). Customers get the approved FAQ
# answer meanwhile, and search is never affected.
LLM_FAILURE_COOLDOWN_SECONDS=60
# Grounded context: at most this many retrieved FAQs per prompt (1-10) ...
LLM_CONTEXT_MAX_FAQS=3
# ... within this many characters of evidence (500-50000; about 4 characters per token).
# Approved answers are never truncated: an FAQ that does not fit is left out.
LLM_CONTEXT_MAX_CHARS=6000

# --- Usage tracking: cost ESTIMATES (monitoring only, not billing) ---------------------
# Token counts are always taken from the API's own usage data. A cost estimate is only
# calculated for models listed here; others report no cost. No prices are built in:
# copy the current rates you pay from your OpenAI pricing page and keep them up to date.
# JSON object: model name -> prices per 1 million tokens (cached input is optional and
# defaults to the input price). A model name also covers its dated snapshots, e.g.
# "gpt-5.4-mini" prices "gpt-5.4-mini-2026-03-17". Example shape (replace the zeros):
#   LLM_PRICING={"gpt-5.4-mini": {"input_per_million_tokens": 0.0, "output_per_million_tokens": 0.0, "cached_input_per_million_tokens": 0.0}}
LLM_PRICING={}
# Currency of those prices (ISO 4217 code).
LLM_PRICING_CURRENCY=USD


# =============================================================================
# 4. AI: retrieval and answer decisions
# =============================================================================

# Sentence-embedding model for semantic search: a Hugging Face model ID or a local folder
# (the Docker deployment uses the pinned folder /models/all-MiniLM-L6-v2). The model is
# NOT loaded when the app is imported; it loads when first needed. Where it is cached:
# see section 8.
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# false | true | background. When to load the embedding model and build the semantic
# FAQ index (30-160 s the first time on a laptop CPU):
#   false       on the first semantic search, which waits for it (and may take longer
#               than the pages' 60 s read timeout);
#   true        during startup: the server accepts requests once it is loaded;
#   background  right after startup, in a background thread: the server answers at
#               once, and a chat arriving earlier waits for the same load.
# If loading fails, the app still runs (keyword-only answers) and retries later. Each
# worker process holds its own model and index; run one worker (SEC-09, SEC-10).
SEMANTIC_INDEX_PRELOAD=false

# Seconds to wait after a failed model load before trying again (0-3600). Meanwhile
# semantic search answers 503 with a Retry-After header instead of every queued
# request repeating a slow failing download.
EMBEDDING_LOAD_RETRY_SECONDS=30

# Default result filter of the POST /api/v1/semantic-search endpoint (cosine, -1 to 1).
# Results scoring below it are not returned. Callers can override it per request with
# "min_similarity"; -1 effectively disables it. EXPERIMENTAL. This does NOT affect the
# answer decision below, which has its own ANSWER_MIN_SIMILARITY.
SEMANTIC_MIN_SIMILARITY=0.40

# --- Decision thresholds -------------------------------------------------------------
# Three separate responsibilities: retrieval ranking, answer acceptance and ambiguity
# detection. All values are EXPERIMENTAL starting points, not universally reliable.
# Calibrate them with a labelled evaluation dataset for your model and knowledge base
# (README, "Decision thresholds"; docs/ai-evaluation-report.md).

# 1. Retrieval ranking: orders candidates; never decides whether to answer.
# Reciprocal Rank Fusion constant k (1-1000). Larger values give lower ranks more weight.
HYBRID_RRF_K=60
# Candidates taken from each retriever (keyword, semantic) before fusion (2-50).
HYBRID_CANDIDATE_DEPTH=20
# Top-ranked candidates the answer decision evaluates (2-50, <= HYBRID_CANDIDATE_DEPTH).
ANSWER_CANDIDATES=5

# 2. Answer acceptance: is a candidate relevant enough to show?
# Minimum semantic cosine similarity (-1 to 1) for an FAQ to be answered.
ANSWER_MIN_SIMILARITY=0.40
# true | false. Accept an exact (normalised) question match on its own.
ANSWER_ACCEPT_EXACT_QUESTION=true
# Semantic model unavailable: keyword-only answers need an exact question match, or a
# clear keyword score at least this high (1-1000; 40 = query is inside the question) ...
DEGRADED_MIN_KEYWORD_SCORE=40
# ... from a query with at least this many meaningful (non-stopword) words (1-20).
DEGRADED_MIN_QUERY_TERMS=2

# 3. Ambiguity detection: are acceptable candidates too close to choose between?
# Another acceptable FAQ within this cosine margin of the top one (or above it) leads to
# a clarifying question instead of an answer (0-1).
ANSWER_AMBIGUITY_MARGIN=0.05
# Most FAQs named in one clarifying question (2-10).
ANSWER_MAX_CLARIFICATION_OPTIONS=3

# Customer-facing text when no FAQ answer is given (1-500 characters).
FALLBACK_NO_MATCH_MESSAGE="Sorry, I couldn't find a reliable answer to that question. Please contact our support team for assistance."
FALLBACK_UNAVAILABLE_MESSAGE="Sorry, I can't search our help articles right now. Please try again in a few minutes or contact our support team for assistance."


# =============================================================================
# 5. Conversations
# =============================================================================

# While one message is being answered, other messages to the same conversation are
# refused with 409 and Retry-After. The lock is a lease stored in the database: it is
# released when the reply is stored, or expires after this many seconds (10-900) if the
# process died. It must outlast the slowest answer: with LLM_ENABLED=true, at least
# OPENAI_TIMEOUT_SECONDS x (OPENAI_MAX_RETRIES + 1) x 2 plus backoff (checked at startup).
CONVERSATION_PROCESSING_LEASE_SECONDS=180

# true | false. Delete expired conversations and their messages when the app starts.
# Run the same cleanup any time with: python -m scripts.cleanup_conversations
CONVERSATION_CLEANUP_ON_STARTUP=true

# Context window. CHARACTER limits (*_CHARS) count characters of message text; the TOKEN
# limit (*_TOKENS) counts model tokens. Older context is omitted first, never summarised.
# Recent history used as context for a new message: at most this many messages (1-50)
# and this many characters of message text in total (200-50000).
CONVERSATION_HISTORY_MAX_MESSAGES=10
CONVERSATION_HISTORY_MAX_CHARS=4000
# A single history message longer than this many characters (100-10000) is shortened to
# its beginning, so one long reply cannot push out the rest of the conversation.
CONVERSATION_HISTORY_MAX_MESSAGE_CHARS=1000
# TOKEN limit (500-200000) for an LLM request that includes history (query rewriting).
# Instructions, the new message and the reserved output are counted first; history gets
# what is left, newest first. If even those do not fit, the LLM is not called.
CONVERSATION_CONTEXT_MAX_TOKENS=3000
# How tokens are counted: estimate (UTF-8 bytes / 3, no download; usually over-counts
# English) | tiktoken (exact for OpenAI models; downloads TIKTOKEN_ENCODING once and
# falls back to the estimate if it cannot).
CONTEXT_TOKENIZER=estimate
TIKTOKEN_ENCODING=o200k_base

# true | false. Rewrite follow-up messages ("what about after that?") into standalone
# search queries with the LLM, when LLM_ENABLED=true. Rewrites are checked and rejected
# if they add words or numbers not in the conversation. Without the LLM (or when a
# rewrite is rejected) the earlier customer question is put before the follow-up.
QUERY_REWRITE_USE_LLM=true
# Most recent history messages considered when rewriting (1-20).
QUERY_REWRITE_MAX_TURNS=6


# =============================================================================
# 6. Support tickets: human handoff and sales leads (docs/human-handoff.md)
# =============================================================================

# Your approved statement about response times, shown after a request is sent, e.g.
# "We usually reply within one working day." Empty = none is shown (never invented).
SUPPORT_RESPONSE_TIME_TEXT=
# The same request sent again in the same conversation within this many minutes, while
# its ticket is open, returns that ticket instead of creating another (1-43200).
TICKET_DUPLICATE_WINDOW_MINUTES=1440
# Closed tickets older than this are anonymized by: python -m scripts.anonymize_support_data
# (personal data replaced, statuses and audit events kept; 1-3650 days).
SUPPORT_TICKET_RETENTION_DAYS=365


# =============================================================================
# 7. Streamlit pages (frontend/app.py, frontend/admin_app.py). Read by the pages only.
# Connection, session and input limits are in sections 1 and 2.
# =============================================================================

# Seconds to connect (0-60) and to wait for a reply (0-600). A reply can include LLM calls.
BACKEND_CONNECT_TIMEOUT_SECONDS=5
BACKEND_READ_TIMEOUT_SECONDS=60
# Automatic retries of one message (0-5) after a network error, 409, 429 or 503, always
# with the same client_message_id; and the longest Retry-After waited for (0-30 s).
BACKEND_MAX_RETRIES=2
BACKEND_MAX_RETRY_WAIT_SECONDS=5
# Optional "Contact support" link shown when no reliable answer is found.
SUPPORT_CONTACT_URL=
# One-click questions on an empty conversation (JSON list, up to 6).
EXAMPLE_QUESTIONS=["How can I track my order?","What is your return policy?","How do I reset my password?"]
# true shows a demo notice: fictional sample data, and how answers are produced right
# now (approved text, or AI rewording on or paused), read from the backend. See
# docs/demo-guide.md; scripts/start-demo.ps1 turns it on.
DEMO_MODE=false


# =============================================================================
# 8. Deployment
# =============================================================================
#
# Docker Compose (deploy/compose.yaml) uses two levels of configuration:
#   deploy/.env                              Compose variables (deploy/.env.example):
#                                            public hostname (PUBLIC_HOSTNAME), staff
#                                            dashboard hostname and listener
#                                            (ADMIN_HOSTNAME, ADMIN_BIND, ADMIN_HTTPS_PORT),
#                                            reverse proxy ports and interface, the
#                                            environment folder and the model revision.
#   deploy/environments/<env>/*.env          This file's variables, per service and
#                                            environment (production, staging).
# Compose refuses to start without DEPLOY_ENV, PUBLIC_HOSTNAME, the environment files,
# the TLS certificate folder or the dashboard's password file. In Compose, DATABASE_URL,
# FAQ_DATA_PATH, EMBEDDING_MODEL_NAME and BACKEND_API_URL are fixed by compose.yaml.
#
# Model cache (Hugging Face's own environment variables, not settings of this app):
#   HF_HOME          where models are cached outside Docker. Default
#                    %USERPROFILE%\.cache\huggingface (Windows) or ~/.cache/huggingface.
#                    The first semantic search downloads the model (~90 MB) there once.
#   HF_HUB_OFFLINE   1 = never contact Hugging Face; load only cached or local models.
#                    The Docker image sets it, with the model in the read-only
#                    /models volume, so containers never download at startup.
# Example (local, optional):
#   HF_HOME=D:\models\huggingface
#   HF_HUB_OFFLINE=1
